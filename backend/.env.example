# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_engine

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# AI (the Engine) — set one or more providers; the Engine fails over
# automatically to the next configured provider if the active one is down.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
ENGINE_MODEL=claude-sonnet-5
ENGINE_MAX_ITERATIONS=25

# Web research (phase 1)
SEARCH_API_KEY=
SEARCH_API_PROVIDER=brave

# Email (phase 1)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SMS (phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Voice (phase 2)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
