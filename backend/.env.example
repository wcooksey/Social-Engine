# =============================================================================
# Required environment variables
# =============================================================================
# Only the values below need to live in the environment. Everything else
# (AI provider keys, search, email/SMS/voice creds, engine concurrency knobs)
# is now configured in-app on the Settings page and stored in the database.
# Any variable listed further down still works as a fallback if a matching
# in-app setting hasn't been saved — handy for seeding a fresh deployment.

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_engine

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# 32-byte key (64 hex chars) used to encrypt stored secrets at rest —
# social login sessions AND secret org settings (API keys, tokens).
# Required to save any secret setting. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Super admin: the single account that can edit platform-wide settings
# (engine iterations, worker concurrency, per-org caps, poll interval).
SUPER_ADMIN_EMAIL=

# Public base URL of this deployment, no trailing slash (e.g.
# https://app.yourdomain.com). Used to build the booking links and unsubscribe
# links that leads click. Defaults to http://localhost:3000 for local dev.
APP_PUBLIC_URL=

# Shared secret for inbound reply webhooks (Mailgun routes, Twilio SMS,
# social bridges). REQUIRED for two-way conversations — the endpoints fail
# closed and reject everything until this is set. Generate: openssl rand -hex 24
# Append it to the webhook URLs: .../api/webhooks/inbound/email?secret=<value>
INBOUND_WEBHOOK_SECRET=

# Extra allowed CORS origins in production (comma-separated). Leave empty when
# the backend serves the frontend itself (the default single-service deploy).
CORS_ORIGINS=

# Default Engine model when an org hasn't chosen one.
ENGINE_MODEL=claude-sonnet-5

# =============================================================================
# Optional fallbacks — prefer the in-app Settings page instead
# =============================================================================
# Per-organization integration settings. Configure these under
# Settings → Integrations & API keys. Set here only to provide a default
# for orgs that haven't saved their own.

# AI providers (the Engine fails over to the next configured provider)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# Web research
# SEARCH_API_KEY=
# SEARCH_API_PROVIDER=brave
# Google Places API key — powers source_local_businesses (systematic "find all
# X in Y" lead sourcing). Enable "Places API (New)" on a Google Cloud project.
# GOOGLE_PLACES_API_KEY=
# Apollo.io API key — decision-maker enrichment (find owner/GM emails by
# company domain + title). Optional: website crawl works without it.
# APOLLO_API_KEY=

# Email (Mailgun)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# From address for outbound mail; blank = noreply@<MAILGUN_DOMAIN>
# MAILGUN_FROM_EMAIL=

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Voice (Vapi AI calls). Note: the Vapi end-of-call webhook fails closed —
# an org must have VAPI_WEBHOOK_SECRET resolved (in-app setting or this env
# fallback) for its call reports to be processed.
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_WEBHOOK_SECRET=
# VAPI_ASSISTANT_MODEL=gpt-4o
# VAPI_VOICE_PROVIDER=11labs
# VAPI_VOICE_ID=burt

# Platform-wide engine knobs (super-admin Settings page; env is the fallback)
# ENGINE_MAX_ITERATIONS=25
# ENGINE_WORKER_CONCURRENCY=4
# ENGINE_ORG_CONCURRENCY=2
# ENGINE_WORKER_INTERVAL_MS=5000
