generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & TENANCY
// ============================================

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI model powering the Engine (null = server default)
  engineModel String?
  // Model for the Sandbox call coach. Separate on purpose: the Engine runs all
  // day and is tuned for cost, while tuning the phone script is a one-off
  // conversation worth spending the best available model on.
  coachModel String?

  // Autonomy guardrails
  dailySendCap Int     @default(200)
  /// Ceiling on AI spend per UTC day, in USD. Null means no ceiling. Cost was
  /// measured and displayed but never enforced, so the only backstop against a
  /// mis-scoped objective or an unsatisfiable goal looping forever was a human
  /// noticing a number on the admin page.
  dailyAiSpendCapUsd Decimal? @db.Decimal(10, 2)
  quietHoursStart Int  @default(20) // 24h local hour — no outbound after
  quietHoursEnd   Int  @default(8)
  paused          Boolean @default(false) // kill switch: Engine takes no outbound actions
  // Autonomous social DMs are off by default (platform ToS risk): the browser
  // agent researches freely but drafts DMs for approval unless this is on.
  socialAutonomy  Boolean @default(false)

  users        User[]
  leadGroups   LeadGroup[]
  leads        Lead[]
  contacts     Contact[]
  campaigns    Campaign[]
  activities   Activity[]
  conversations Conversation[]
  agentRuns    AgentRun[]
  agentJobs    AgentJob[]
  engineChats  EngineChat[]
  calendarEvents CalendarEvent[]
  playbooks    Playbook[]
  socialAccounts SocialAccount[]
  experiments  Experiment[]
  orgSettings  OrgSetting[]
  bookingLinks BookingLink[]
  notifications Notification[]
  coverageCells CoverageCell[]
  autopilotGoals AutopilotGoal[]
  emailDomains EmailDomain[]
  mailboxes    Mailbox[]
  senderPools  SenderPool[]
  suppressions Suppression[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(MEMBER)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Bumped on logout / password change to invalidate all issued JWTs.
  tokenVersion   Int          @default(0)
  // Whether this user receives notification emails (alerts + daily digest).
  notifyByEmail  Boolean      @default(true)

  engineChats EngineChat[]
  agentRuns   AgentRun[]
  notifications Notification[]

  @@index([organizationId])
}

// ============================================
// CRM CORE
// ============================================

enum LeadStatus {
  NEW
  RESEARCHING
  CONTACTED
  ENGAGED
  INTERESTED
  NOT_INTERESTED
  CUSTOMER
  ARCHIVED
}

model LeadGroup {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  goal           String?      // what the Engine is trying to accomplish with this group
  aiSummary      String?      // rolling summary maintained by the Engine
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads     Lead[]
  playbooks Playbook[]
  coverageCells CoverageCell[]
  autoEnrollCampaigns Campaign[]
  autopilotGoals      AutopilotGoal[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================
// COVERAGE TRACKING (systematic enumeration)
// ============================================

enum CoverageCellStatus {
  PENDING
  IN_PROGRESS
  DONE
  EMPTY // searched, nothing there
}

/// One cell of a bird's-eye sourcing objective ("dealerships in Florida"),
/// e.g. "Toyota dealerships — Tampa, FL". The Coordinator plans the grid;
/// Researchers claim cells atomically, source leads into the group, and mark
/// them done — so across any number of sessions/agents the system knows
/// exactly what has and hasn't been covered, with no repeated searches.
model CoverageCell {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String
  group          LeadGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label      String // human-readable, e.g. "Toyota dealerships — Tampa, FL"
  query      String // the search to run, e.g. "Toyota dealership in Tampa, FL"
  status     CoverageCellStatus @default(PENDING)
  leadsFound Int      @default(0)
  notes      String?
  lastRunAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, query])
  @@index([organizationId, status])
  @@index([groupId, status])
}

/// How well a lead is enriched — i.e. how reachable it actually is right now.
/// Derived from the lead + its contacts by the enrichment scorer, stored
/// denormalized so hundreds of leads can be filtered/sorted/counted in SQL.
enum EnrichmentTier {
  NONE // no email, no phone, no social — unreachable, needs work or dropping
  MINIMAL // company-level only (main line / generic inbox), no named person
  PARTIAL // some person-level detail, but a channel or the decision maker is missing
  GOOD // a named contact with a direct email or phone — workable today
  RICH // decision maker(s), verified email, phone, socials — nothing left to find
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String?
  group          LeadGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  companyName String
  website     String?
  /// Normalized website host. NOT a unique key: multi-location businesses —
  /// dealer groups especially — routinely run every rooftop off one corporate
  /// domain, and treating the domain as an identity collapses them into a
  /// single lead. Used as a dedup *hint*, corroborated by name or city.
  domain      String?
  /// Stable per-location id from the source directory (Google Places). This is
  /// the real identity for a physical location, so two rooftops of the same
  /// group stay two leads.
  placeId     String?
  /// Set when a sibling location sharing this lead's website opted out. The
  /// rooftops are legally separate businesses, so this is not an opt-out — it
  /// is a "check before contacting", cleared once the Engine or a human has
  /// established whether they are genuinely independent.
  contactReviewReason String?
  phone       String?
  /// Last 10 digits of `phone`, kept in step by the lead service. Stored so
  /// phone dedup is an indexed lookup: it used to scan an arbitrary unordered
  /// 2,000 rows on every upsert, which both cost a table read per write and
  /// silently stopped matching once an org passed 2,000 leads.
  phoneNormalized String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  country     String?      @default("US")
  industry    String?
  status      LeadStatus   @default(NEW)
  // Hard opt-out (SMS STOP / unsubscribe). Enforced deterministically in the
  // send tools — never left to the AI's discretion. Compliance: TCPA/CAN-SPAM.
  doNotContact Boolean     @default(false)
  // IANA timezone (e.g. "America/New_York"), derived from state when unknown.
  // Quiet-hours guardrails compute the lead's LOCAL hour from this.
  timezone    String?
  source      String?      // how it was found: "web_research", "manual", "import"
  aiSummary   String?      // Engine's rolling notes on this lead
  socials     Json?        // { linkedin, facebook, instagram, x, ... }
  metadata    Json?

  // --- Enrichment quality (denormalized; recomputed on every lead/contact write) ---
  // Answers "which of these hundreds of leads are actually workable, and which
  // still need research?" without N+1 queries over contacts.
  enrichmentScore   Int            @default(0) // 0-100, weighted signal coverage
  enrichmentTier    EnrichmentTier @default(NONE)
  emailCount        Int            @default(0) // usable contact emails (not bounced/opted-out)
  phoneCount        Int            @default(0) // usable phones (lead line + contact directs)
  contactCount      Int            @default(0) // people on file
  enrichmentGaps    Json?          // string[] of missing signals, e.g. ["email","decision_maker"]
  // Capability generation the last enrichment pass ran under. When the platform
  // gains new enrichment powers we bump ENRICHMENT_CAPABILITY_VERSION, and every
  // lead below it becomes re-workable — that is how "retry the old leads with the
  // new tools" stays a database fact instead of an agent's memory.
  enrichmentVersion       Int       @default(0)
  lastEnrichedAt          DateTime? // last attempt that actually ADDED data
  lastEnrichmentAttemptAt DateTime? // last attempt, successful or not (cooldown)
  enrichmentAttempts      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  activities    Activity[]
  conversations Conversation[]
  campaignLeads CampaignLead[]
  agentJobs     AgentJob[]
  calendarEvents CalendarEvent[]

  @@unique([organizationId, placeId])
  @@index([organizationId, domain])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, status])
  @@index([organizationId, state])
  @@index([groupId])
  // Triage queries: "weakest leads in this group the new tools haven't seen yet".
  @@index([organizationId, enrichmentTier])
  @@index([organizationId, enrichmentScore])
  @@index([organizationId, enrichmentVersion])
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  title     String? // "General Manager", "Owner", ...
  email     String?
  phone     String?
  socials   Json?
  source    String?
  isPrimary Boolean @default(false)
  optedOut  Boolean @default(false)
  // Deliverability suppression from Mailgun events: null=ok, 'bounced', 'complained'.
  // Any non-null value means "do not send here" — a verified-good address is
  // recorded on emailVerifiedAt instead, never here.
  emailStatus String?
  // Set when Mailgun validation confirmed the address is deliverable. The
  // strongest enrichment signal a lead can carry: a channel we know works.
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations  Conversation[]
  calendarEvents CalendarEvent[]

  @@unique([leadId, email])
  @@index([organizationId])
  @@index([leadId])
}

// ============================================
// CAMPAIGNS & OUTREACH
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignMode {
  AUTONOMOUS        // Engine sends without approval
  APPROVAL_REQUIRED // Engine drafts; a human approves each send
}

enum Channel {
  EMAIL
  SMS
  VOICE
  SOCIAL
}

model Campaign {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  offer          String?        // the pitch/offer the Engine works from
  channels       Channel[]
  mode           CampaignMode   @default(APPROVAL_REQUIRED)
  status         CampaignStatus @default(DRAFT)
  aiSummary      String?
  followUpCadenceDays Int       @default(3)
  maxTouches          Int       @default(6)
  // Leads that land in this group are enrolled automatically by the cadence
  // sweep — closes the sourcing -> outreach gap without agent judgment.
  autoEnrollGroupId   String?
  autoEnrollGroup     LeadGroup? @relation(fields: [autoEnrollGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignLeads CampaignLead[]
  autopilotGoals AutopilotGoal[]
  activities    Activity[]
  agentJobs     AgentJob[]
  playbooks     Playbook[]
  messages      Message[]

  @@index([organizationId, status])
  @@index([autoEnrollGroupId])
}

enum CampaignLeadStatus {
  PENDING
  IN_SEQUENCE
  REPLIED
  INTERESTED
  NOT_INTERESTED
  COMPLETED
  REMOVED
}

model CampaignLead {
  id         String             @id @default(uuid())
  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     CampaignLeadStatus @default(PENDING)
  touchCount Int                @default(0)
  lastTouchAt DateTime?
  nextTouchAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([campaignId, leadId])
  @@index([leadId])
  @@index([campaignId, status])
}

// ============================================
// TIMELINE & CONVERSATIONS
// ============================================

enum ActivityType {
  NOTE
  RESEARCH
  STATUS_CHANGE
  EMAIL_SENT
  EMAIL_REPLY
  SMS_SENT
  SMS_REPLY
  EMAIL_OPENED
  EMAIL_CLICKED
  CALL_PLACED
  CALL_COMPLETED
  SOCIAL_TOUCH
  FOLLOW_UP_SCHEDULED
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agentRunId     String?
  agentRun       AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  type    ActivityType
  summary String
  payload Json? // channel-specific detail (message body, call transcript ref, urls)

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([campaignId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel        Channel
  subject        String?
  lastMessageAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Sticky sender: once a lead has heard from this mailbox, every follow-up
  // comes from it too. Rotating mid-thread breaks threading and reads as spoofing.
  mailboxId String?
  mailbox   Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([organizationId, lastMessageAt])
  @@index([leadId])
  @@index([mailboxId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  /// Subject for this specific send. The conversation carries the thread's
  /// original subject; a queued message needs its own, because it is composed
  /// now and put on the wire later.
  subject        String?
  status         String?          // queued | scheduled | sent | delivered | failed | draft_pending_approval
  externalId     String?          // provider message id (Mailgun/Twilio)
  sentAt         DateTime?
  /// When a `scheduled` message is due. Sender pacing composes the message now
  /// and holds it here rather than discarding it and re-running the agent later.
  scheduledAt    DateTime?
  /// Display name this was composed to go out under, frozen at compose time.
  /// Identity is resolved from the lead's current status and group, and both can
  /// move while a message waits — re-deriving it at send time can put one
  /// person's name on a From header above another person's sign-off.
  senderName     String?
  createdAt      DateTime         @default(now())

  // Split-test attribution: which variant this outbound message used, and
  // whether a reply to it has been counted (so responses can't be double-counted).
  experimentVariantId String?
  experimentVariant   ExperimentVariant? @relation(fields: [experimentVariantId], references: [id], onDelete: SetNull)
  gotResponse         Boolean            @default(false)

  // Which mailbox put this on the wire. Without it a bounce can be traced to the
  // recipient but never to the sender that earned it.
  mailboxId String?
  mailbox   Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)

  /// Campaign this send belongs to. A queued message is put on the wire without
  /// an agent present, so it has to carry its own cadence attribution rather
  /// than relying on the caller still being around to supply it.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([experimentVariantId])
  @@index([mailboxId])
  @@index([campaignId])
  // Drives the outbound queue drain: due scheduled sends, oldest first.
  @@index([status, scheduledAt])
}

// ============================================
// SPLIT TESTING (experiments)
// ============================================

enum ExperimentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Experiment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  channel Channel          // which channel this experiment tests
  goal    String?          // what a "response" means / what we're optimizing for
  status  ExperimentStatus @default(ACTIVE)
  groupId    String?
  campaignId String?
  winnerVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ExperimentVariant[]

  @@index([organizationId, status])
}

model ExperimentVariant {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  label   String
  content String  // the message template / approach the AI uses for this variant
  weight  Int     @default(1)

  sends             Int @default(0)
  responses         Int @default(0)
  positiveResponses Int @default(0)

  createdAt DateTime @default(now())

  messages Message[]

  @@index([experimentId])
}

// ============================================
// ENGINE (AI AGENT LAYER)
// ============================================

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunTrigger {
  USER_CHAT
  SCHEDULED_JOB
  WEBHOOK
}

enum AgentRole {
  COORDINATOR // generalist: all tools (live chat + custom jobs)
  RESEARCHER  // prospecting, enrichment, dedup — no outbound sending
  CALLER      // AI voice calls + booking
  SDR         // email / SMS / social outreach
}

model AgentRun {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  trigger        AgentRunTrigger
  role           AgentRole       @default(COORDINATOR)
  objective      String          // what this run was asked to do
  model          String?         // model that actually served the run (after any failover)
  status         AgentRunStatus  @default(RUNNING)
  summary        String?         // written by the Engine at the end (rolling memory)
  error          String?
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  // Portion of inputTokens the provider served from its prompt cache — a
  // subset, not an addition. Stored so a cost figure can be audited against
  // the provider's own bill instead of taken on faith, since cache hits are
  // priced up to ~120x lower and dominate an agent loop's input.
  cachedInputTokens Int          @default(0)
  // Estimated USD cost at list prices (accumulated per LLM call, incl. the
  // browser agent's calls attributed back to this run).
  costUsd        Float           @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  steps      AgentStep[]
  activities Activity[]
  chatMessages EngineChatMessage[]

  @@index([organizationId, startedAt])
}

model AgentStep {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index      Int
  type       String   // "thinking" | "tool_call" | "tool_result" | "message"
  toolName   String?
  input      Json?
  output     Json?
  createdAt  DateTime @default(now())

  @@index([runId, index])
}

enum AgentJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentJobType {
  FOLLOW_UP
  RESEARCH
  CAMPAIGN_STEP
  CUSTOM
}

model AgentJob {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Line of business this job belongs to, inherited from the run that
  // scheduled it. Concurrency is capped per playbook as well as per org, so a
  // deep queue for one playbook can't hold up another — two lines of business
  // run side by side instead of one waiting for the other to drain.
  playbookId     String?
  playbook       Playbook?    @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  type      AgentJobType
  role      AgentRole      @default(COORDINATOR)
  objective String       // instruction the Engine executes when the job fires
  payload   Json?
  runAt     DateTime
  status    AgentJobStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  createdByRunId String?   // AgentRun that scheduled this (self-scheduling audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([playbookId, status])
}

// ============================================
// AUTOPILOT (standing goals that re-seed work)
// ============================================

enum AutopilotGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// A standing objective the platform keeps working mechanically: a sweep
// re-queues an agent job on a cadence until the goal completes, so autonomy
// no longer depends on each agent remembering to schedule its successor.
/// What an Autopilot goal counts toward its target. "How many leads are in the
/// group" and "how many of them can we actually reach" are different questions,
/// and a sourcing run answers only the first.
enum AutopilotMetric {
  LEAD_COUNT // leads in the linked group — sourcing progress
  ENRICHED_LEADS // leads enriched to GOOD/RICH — ready for outreach
  LEADS_WITH_EMAIL // leads with at least one usable email address
}

model AutopilotGoal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  objective String              // the instruction each queued job executes
  role      AgentRole           @default(COORDINATOR)
  status    AutopilotGoalStatus @default(ACTIVE)
  cadenceHours Int              @default(24)

  // Optional completion criteria / context
  leadGroupId     String?
  leadGroup       LeadGroup? @relation(fields: [leadGroupId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  targetLeadCount Int?       // goal completes when the metric below reaches this number
  // WHAT gets counted toward targetLeadCount. Sourcing goals want raw group
  // size; enrichment goals must NOT, because sourcing already satisfied that
  // number — counting leads instead of reachable leads completes an enrichment
  // goal before it does any work.
  targetMetric    AutopilotMetric @default(LEAD_COUNT)

  nextRunAt    DateTime  @default(now())
  lastQueuedAt DateTime?
  lastResult   String?   // outcome of the most recent queued job (for the UI)
  createdByRunId String? // AgentRun that created this goal (audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([status, nextRunAt])
}

// ============================================
// SETTINGS (DB-backed config; overrides env)
// ============================================

// Per-organization integration config (API keys etc.). Secrets are stored
// encrypted. Resolution precedence at read time: OrgSetting -> env -> default.
model OrgSetting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  isSecret       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

// Platform-wide config, editable only by the super admin.
model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// SUPPRESSION (opt-out that outlives the lead row)
// ============================================

enum SuppressionKind {
  EMAIL
  PHONE
  /// Every address at a company, e.g. after a "remove our whole firm" request.
  DOMAIN
}

/// A standing "never contact this" for an organization.
///
/// Opt-out used to be a flag on the lead and contact rows, which meant it died
/// with them: delete a lead, or re-source the same business under a different
/// name or website, and it came back with the flag cleared and started
/// receiving mail again — a repeat violation the system could not even detect.
/// Suppression is keyed on the contact detail itself, so it survives whatever
/// happens to the records around it.
model Suppression {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind  SuppressionKind
  /// Normalized: lowercased email/domain, last-10-digits phone.
  value String

  /// Free text for a human reading the record later.
  reason String?
  /// Where it came from: unsubscribe_link | sms_stop | spam_complaint |
  /// voice_optout | manual | bounce.
  source String?
  /// The lead it originated from, for context. Kept even if that lead is later
  /// deleted, which is the whole point.
  originLeadId String?

  createdAt DateTime @default(now())

  @@unique([organizationId, kind, value])
  @@index([organizationId, kind])
}

// ============================================
// SENDING INFRASTRUCTURE (domains, mailboxes, pools)
// ============================================

/// What a domain is allowed to carry. Cold outreach burns sender reputation
/// over time; meeting invites and booking confirmations must not go down with
/// it, so they ride a domain that never sends cold mail.
enum DomainPurpose {
  COLD_OUTREACH
  TRANSACTIONAL
}

enum EmailDomainStatus {
  PENDING // added here, DNS not verified with the provider yet — cannot send
  WARMING
  ACTIVE
  PAUSED // tripped a health threshold, or paused by hand
  RETIRED
}

/// A sending domain. Registrar is irrelevant — this is whoever puts mail on the
/// wire for it (Mailgun today; `provider` leaves room for SMTP mailboxes later
/// without a second model).
model EmailDomain {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Globally unique, not per-org: inbound replies are routed to an org by their
  // recipient domain, so two orgs claiming one domain would be ambiguous.
  domain   String            @unique
  provider String            @default("mailgun")
  purpose  DomainPurpose     @default(COLD_OUTREACH)
  status   EmailDomainStatus @default(PENDING)
  /// Per-domain provider key, encrypted. Null inherits the org's MAILGUN_API_KEY.
  apiKeyEncrypted String?

  // DNS/auth verification, refreshed from the provider. Null = not checked yet.
  spfOk         Boolean?
  dkimOk        Boolean?
  mxOk          Boolean? // no MX means replies never reach us at all
  trackingOk    Boolean? // per-domain tracking CNAME; a shared one hurts deliverability
  lastCheckedAt DateTime?

  pausedReason String?
  firstSendAt  DateTime? // start of the domain's own reputation history

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailboxes Mailbox[]

  @@index([organizationId, status])
}

enum MailboxStatus {
  WARMING
  ACTIVE
  PAUSED
  RETIRED
}

/// One sending address. On Mailgun these are logical — any address on a verified
/// domain can send — but they are the unit reputation is earned and spent in, so
/// caps, stats and pauses all hang here rather than on the domain.
model Mailbox {
  id             String       @id @default(uuid())
  organizationId String // denormalized so tenant-scoped queries skip the join
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId       String
  emailDomain    EmailDomain  @relation(fields: [domainId], references: [id], onDelete: Cascade)

  localPart String // "dana"
  /// Full address, denormalized: delivery events and reply routing match on it.
  address     String  @unique
  displayName String?
  replyTo     String?

  status MailboxStatus @default(WARMING)

  // Warm-up ramp. Phase 2 enforces these; they are stored now so the ramp clock
  // starts the day a mailbox is created, not the day the enforcement lands.
  warmupStartedAt DateTime?
  dailyCapStart   Int       @default(5)
  dailyCapMax     Int       @default(40)
  warmupGrowthPct Int       @default(30)
  hourlyCap       Int       @default(8)

  pausedReason String?
  pausedUntil  DateTime?
  lastSendAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyStats    MailboxDailyStat[]
  messages      Message[]
  conversations Conversation[]
  pools         SenderPoolMailbox[]

  @@unique([domainId, localPart])
  @@index([organizationId, status])
}

/// Per-day send ledger. The cap is enforced against this rather than a count
/// over Activity, so one mailbox's volume is knowable without scanning the org.
model MailboxDailyStat {
  id        String   @id @default(uuid())
  mailboxId String
  mailbox   Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  sent       Int @default(0)
  delivered  Int @default(0)
  bounced    Int @default(0)
  complained Int @default(0)
  opened     Int @default(0)
  replied    Int @default(0)

  @@unique([mailboxId, date])
  @@index([date])
}

/// A named set of mailboxes a playbook sends through — one persona, one brand,
/// or one offer's worth of capacity.
model SenderPool {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mailboxes SenderPoolMailbox[]
  playbooks Playbook[]

  @@unique([organizationId, name])
}

model SenderPoolMailbox {
  poolId    String
  pool      SenderPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  mailboxId String
  mailbox   Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([poolId, mailboxId])
  @@index([mailboxId])
}

// ============================================
// SOCIAL ACCOUNTS (persistent browser logins)
// ============================================

enum SocialPlatform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
}

model SocialAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  label    String              @default("default")
  // AES-256-GCM encrypted Playwright storageState (cookies + localStorage).
  // This IS the login — treated as a secret, never returned by the API.
  encryptedState String
  status         SocialAccountStatus @default(CONNECTED)
  lastValidatedAt DateTime?
  lastUsedAt      DateTime?
  // Last time the inbound DM sweep read this account's inbox for replies.
  lastInboxSweepAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, platform, label])
  @@index([organizationId])
}

// ============================================
// PLAYBOOKS (custom Engine protocols)
// ============================================

enum PlaybookScope {
  GLOBAL
  GROUP
  CAMPAIGN
  LEAD_STATUS
}

enum PlaybookChannel {
  ALL
  EMAIL
  SMS
  VOICE
}

model Playbook {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  scope        PlaybookScope   @default(GLOBAL)
  groupId      String?
  group        LeadGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadStatus   LeadStatus?
  channel      PlaybookChannel @default(ALL)
  instructions String
  isActive     Boolean         @default(true)
  priority     Int             @default(100)

  // --- Sending identity (all optional) ------------------------------------
  // Who outreach run under this playbook presents as. Lets one account work
  // several employees or several services it sells without needing a separate
  // organization for each. Resolved deterministically at send time — the
  // highest-priority active playbook whose scope matches the lead and that has
  // an identity wins; anything blank falls back to the organization.
  identityName      String? // person the outreach comes from, e.g. "Dana Reeves"
  identityOrgName   String? // business/brand to present as
  identityTitle     String? // job title — used in prompts and the call intro
  identityEmail     String? // From/Reply-To; ignored unless it's a known mailbox
  identitySignature String? // sign-off appended to outbound email
  /// Physical postal address for the email footer. CAN-SPAM requires one on
  /// commercial mail, and its absence is itself a spam-filter signal.
  identityPostalAddress String?

  /// Mailboxes outreach under this playbook sends through. Null falls back to
  /// any cold-outreach mailbox the org has.
  senderPoolId String?
  senderPool   SenderPool? @relation(fields: [senderPoolId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engineChats EngineChat[]
  agentJobs   AgentJob[]

  @@index([organizationId, isActive])
  @@index([senderPoolId])
}

// ============================================
// CALENDAR
// ============================================

enum CalendarEventType {
  MEETING
  CALL
  DEMO
  FOLLOW_UP
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  /// Start time passed with no outcome recorded. Distinct from COMPLETED so a
  /// meeting nobody turned up to can be chased rather than counted as a win.
  NO_SHOW
}

model CalendarEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title       String
  description String?
  location    String?
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean             @default(false)

  createdByRunId String? // AgentRun that booked this (Engine audit trail)
  bookingLinkId  String? // set when a lead self-booked via a public link
  bookingLink    BookingLink? @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  // Which lead reminders have already fired (e.g. ["24h","1h"]) so the sweep
  // never double-sends. Null/[] = none sent yet.
  remindersSent  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startAt])
  @@index([leadId])
  @@index([status, startAt])
}

// ============================================
// BOOKING LINKS (leads self-book on the calendar)
// ============================================

model BookingLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  slug           String       @unique // public URL segment
  title          String
  description    String?
  durationMinutes Int         @default(30)
  bufferMinutes  Int          @default(0)
  timezone       String       @default("America/New_York") // tz the windows are defined in
  // Weekly availability windows: { "1": [["09:00","17:00"]], "2": [...] }
  // keyed by ISO weekday (1=Mon..7=Sun). Missing/empty = unavailable that day.
  availability   Json
  active         Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@index([organizationId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  MEETING_BOOKED
  MEETING_REMINDER
  HOT_REPLY
  LEAD_INTERESTED
  CALL_COMPLETED
  DIGEST
  SYSTEM
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // null = visible to the whole org; set = a specific user's notification.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String?
  leadId    String?  // deep-link target (not a FK — lead may be archived)
  read      Boolean  @default(false)
  emailedAt DateTime? // set once an alert email has been sent for this row

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, read])
}

// ============================================
// ENGINE CONSOLE (user <-> AI chat)
// ============================================

model EngineChat {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String       @default("New conversation")
  // Which line of business this conversation belongs to. One account can now
  // work several industries at once (freight in Tampa, dealerships in Florida),
  // and an untagged chat list gives no way to tell them apart. SetNull rather
  // than Cascade: deleting a playbook must never delete the conversations that
  // ran under it — the transcript is the record of what was actually done.
  playbookId     String?
  playbook       Playbook?    @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages EngineChatMessage[]

  @@index([organizationId, updatedAt])
  @@index([userId])
  @@index([playbookId, updatedAt])
}

model EngineChatMessage {
  id        String     @id @default(uuid())
  chatId    String
  chat      EngineChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String     // "user" | "assistant"
  content   String
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([chatId, createdAt])
}
