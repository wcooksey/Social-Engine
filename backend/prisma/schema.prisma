generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & TENANCY
// ============================================

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI model powering the Engine (null = server default)
  engineModel String?

  // Autonomy guardrails
  dailySendCap Int     @default(200)
  quietHoursStart Int  @default(20) // 24h local hour — no outbound after
  quietHoursEnd   Int  @default(8)
  paused          Boolean @default(false) // kill switch: Engine takes no outbound actions
  // Autonomous social DMs are off by default (platform ToS risk): the browser
  // agent researches freely but drafts DMs for approval unless this is on.
  socialAutonomy  Boolean @default(false)

  users        User[]
  leadGroups   LeadGroup[]
  leads        Lead[]
  contacts     Contact[]
  campaigns    Campaign[]
  activities   Activity[]
  conversations Conversation[]
  agentRuns    AgentRun[]
  agentJobs    AgentJob[]
  engineChats  EngineChat[]
  calendarEvents CalendarEvent[]
  playbooks    Playbook[]
  socialAccounts SocialAccount[]
  experiments  Experiment[]
  orgSettings  OrgSetting[]
  bookingLinks BookingLink[]
  notifications Notification[]
  coverageCells CoverageCell[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(MEMBER)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Bumped on logout / password change to invalidate all issued JWTs.
  tokenVersion   Int          @default(0)
  // Whether this user receives notification emails (alerts + daily digest).
  notifyByEmail  Boolean      @default(true)

  engineChats EngineChat[]
  agentRuns   AgentRun[]
  notifications Notification[]

  @@index([organizationId])
}

// ============================================
// CRM CORE
// ============================================

enum LeadStatus {
  NEW
  RESEARCHING
  CONTACTED
  ENGAGED
  INTERESTED
  NOT_INTERESTED
  CUSTOMER
  ARCHIVED
}

model LeadGroup {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  goal           String?      // what the Engine is trying to accomplish with this group
  aiSummary      String?      // rolling summary maintained by the Engine
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  leads     Lead[]
  playbooks Playbook[]
  coverageCells CoverageCell[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// ============================================
// COVERAGE TRACKING (systematic enumeration)
// ============================================

enum CoverageCellStatus {
  PENDING
  IN_PROGRESS
  DONE
  EMPTY // searched, nothing there
}

/// One cell of a bird's-eye sourcing objective ("dealerships in Florida"),
/// e.g. "Toyota dealerships — Tampa, FL". The Coordinator plans the grid;
/// Researchers claim cells atomically, source leads into the group, and mark
/// them done — so across any number of sessions/agents the system knows
/// exactly what has and hasn't been covered, with no repeated searches.
model CoverageCell {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String
  group          LeadGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label      String // human-readable, e.g. "Toyota dealerships — Tampa, FL"
  query      String // the search to run, e.g. "Toyota dealership in Tampa, FL"
  status     CoverageCellStatus @default(PENDING)
  leadsFound Int      @default(0)
  notes      String?
  lastRunAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, query])
  @@index([organizationId, status])
  @@index([groupId, status])
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupId        String?
  group          LeadGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  companyName String
  website     String?
  domain      String? // normalized dedup key (e.g. "sunshinetoyota.com")
  phone       String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  country     String?      @default("US")
  industry    String?
  status      LeadStatus   @default(NEW)
  // Hard opt-out (SMS STOP / unsubscribe). Enforced deterministically in the
  // send tools — never left to the AI's discretion. Compliance: TCPA/CAN-SPAM.
  doNotContact Boolean     @default(false)
  // IANA timezone (e.g. "America/New_York"), derived from state when unknown.
  // Quiet-hours guardrails compute the lead's LOCAL hour from this.
  timezone    String?
  source      String?      // how it was found: "web_research", "manual", "import"
  aiSummary   String?      // Engine's rolling notes on this lead
  socials     Json?        // { linkedin, facebook, instagram, x, ... }
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts      Contact[]
  activities    Activity[]
  conversations Conversation[]
  campaignLeads CampaignLead[]
  agentJobs     AgentJob[]
  calendarEvents CalendarEvent[]

  @@unique([organizationId, domain])
  @@index([organizationId, status])
  @@index([organizationId, state])
  @@index([groupId])
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  title     String? // "General Manager", "Owner", ...
  email     String?
  phone     String?
  socials   Json?
  source    String?
  isPrimary Boolean @default(false)
  optedOut  Boolean @default(false)
  // Deliverability suppression from Mailgun events: null=ok, 'bounced', 'complained'.
  emailStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations  Conversation[]
  calendarEvents CalendarEvent[]

  @@unique([leadId, email])
  @@index([organizationId])
  @@index([leadId])
}

// ============================================
// CAMPAIGNS & OUTREACH
// ============================================

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignMode {
  AUTONOMOUS        // Engine sends without approval
  APPROVAL_REQUIRED // Engine drafts; a human approves each send
}

enum Channel {
  EMAIL
  SMS
  VOICE
  SOCIAL
}

model Campaign {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  offer          String?        // the pitch/offer the Engine works from
  channels       Channel[]
  mode           CampaignMode   @default(APPROVAL_REQUIRED)
  status         CampaignStatus @default(DRAFT)
  aiSummary      String?
  followUpCadenceDays Int       @default(3)
  maxTouches          Int       @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignLeads CampaignLead[]
  activities    Activity[]
  agentJobs     AgentJob[]
  playbooks     Playbook[]

  @@index([organizationId, status])
}

enum CampaignLeadStatus {
  PENDING
  IN_SEQUENCE
  REPLIED
  INTERESTED
  NOT_INTERESTED
  COMPLETED
  REMOVED
}

model CampaignLead {
  id         String             @id @default(uuid())
  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     CampaignLeadStatus @default(PENDING)
  touchCount Int                @default(0)
  lastTouchAt DateTime?
  nextTouchAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([campaignId, leadId])
  @@index([leadId])
  @@index([campaignId, status])
}

// ============================================
// TIMELINE & CONVERSATIONS
// ============================================

enum ActivityType {
  NOTE
  RESEARCH
  STATUS_CHANGE
  EMAIL_SENT
  EMAIL_REPLY
  SMS_SENT
  SMS_REPLY
  CALL_PLACED
  CALL_COMPLETED
  SOCIAL_TOUCH
  FOLLOW_UP_SCHEDULED
}

model Activity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agentRunId     String?
  agentRun       AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  type    ActivityType
  summary String
  payload Json? // channel-specific detail (message body, call transcript ref, urls)

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([campaignId])
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel        Channel
  subject        String?
  lastMessageAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId, lastMessageAt])
  @@index([leadId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  status         String?          // queued | sent | delivered | failed | draft_pending_approval
  externalId     String?          // provider message id (Mailgun/Twilio)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())

  // Split-test attribution: which variant this outbound message used, and
  // whether a reply to it has been counted (so responses can't be double-counted).
  experimentVariantId String?
  experimentVariant   ExperimentVariant? @relation(fields: [experimentVariantId], references: [id], onDelete: SetNull)
  gotResponse         Boolean            @default(false)

  @@index([conversationId, createdAt])
  @@index([experimentVariantId])
}

// ============================================
// SPLIT TESTING (experiments)
// ============================================

enum ExperimentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Experiment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  channel Channel          // which channel this experiment tests
  goal    String?          // what a "response" means / what we're optimizing for
  status  ExperimentStatus @default(ACTIVE)
  groupId    String?
  campaignId String?
  winnerVariantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ExperimentVariant[]

  @@index([organizationId, status])
}

model ExperimentVariant {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  label   String
  content String  // the message template / approach the AI uses for this variant
  weight  Int     @default(1)

  sends             Int @default(0)
  responses         Int @default(0)
  positiveResponses Int @default(0)

  createdAt DateTime @default(now())

  messages Message[]

  @@index([experimentId])
}

// ============================================
// ENGINE (AI AGENT LAYER)
// ============================================

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunTrigger {
  USER_CHAT
  SCHEDULED_JOB
  WEBHOOK
}

enum AgentRole {
  COORDINATOR // generalist: all tools (live chat + custom jobs)
  RESEARCHER  // prospecting, enrichment, dedup — no outbound sending
  CALLER      // AI voice calls + booking
  SDR         // email / SMS / social outreach
}

model AgentRun {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  trigger        AgentRunTrigger
  role           AgentRole       @default(COORDINATOR)
  objective      String          // what this run was asked to do
  model          String?         // model that actually served the run (after any failover)
  status         AgentRunStatus  @default(RUNNING)
  summary        String?         // written by the Engine at the end (rolling memory)
  error          String?
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  steps      AgentStep[]
  activities Activity[]
  chatMessages EngineChatMessage[]

  @@index([organizationId, startedAt])
}

model AgentStep {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index      Int
  type       String   // "thinking" | "tool_call" | "tool_result" | "message"
  toolName   String?
  input      Json?
  output     Json?
  createdAt  DateTime @default(now())

  @@index([runId, index])
}

enum AgentJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentJobType {
  FOLLOW_UP
  RESEARCH
  CAMPAIGN_STEP
  CUSTOM
}

model AgentJob {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  type      AgentJobType
  role      AgentRole      @default(COORDINATOR)
  objective String       // instruction the Engine executes when the job fires
  payload   Json?
  runAt     DateTime
  status    AgentJobStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  createdByRunId String?   // AgentRun that scheduled this (self-scheduling audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([organizationId, status])
  @@index([leadId])
}

// ============================================
// SETTINGS (DB-backed config; overrides env)
// ============================================

// Per-organization integration config (API keys etc.). Secrets are stored
// encrypted. Resolution precedence at read time: OrgSetting -> env -> default.
model OrgSetting {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  isSecret       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

// Platform-wide config, editable only by the super admin.
model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// SOCIAL ACCOUNTS (persistent browser logins)
// ============================================

enum SocialPlatform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
}

model SocialAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  label    String              @default("default")
  // AES-256-GCM encrypted Playwright storageState (cookies + localStorage).
  // This IS the login — treated as a secret, never returned by the API.
  encryptedState String
  status         SocialAccountStatus @default(CONNECTED)
  lastValidatedAt DateTime?
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, platform, label])
  @@index([organizationId])
}

// ============================================
// PLAYBOOKS (custom Engine protocols)
// ============================================

enum PlaybookScope {
  GLOBAL
  GROUP
  CAMPAIGN
  LEAD_STATUS
}

enum PlaybookChannel {
  ALL
  EMAIL
  SMS
  VOICE
}

model Playbook {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  scope        PlaybookScope   @default(GLOBAL)
  groupId      String?
  group        LeadGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadStatus   LeadStatus?
  channel      PlaybookChannel @default(ALL)
  instructions String
  isActive     Boolean         @default(true)
  priority     Int             @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, isActive])
}

// ============================================
// CALENDAR
// ============================================

enum CalendarEventType {
  MEETING
  CALL
  DEMO
  FOLLOW_UP
  OTHER
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model CalendarEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title       String
  description String?
  location    String?
  type        CalendarEventType   @default(MEETING)
  status      CalendarEventStatus @default(SCHEDULED)
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean             @default(false)

  createdByRunId String? // AgentRun that booked this (Engine audit trail)
  bookingLinkId  String? // set when a lead self-booked via a public link
  bookingLink    BookingLink? @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)
  // Which lead reminders have already fired (e.g. ["24h","1h"]) so the sweep
  // never double-sends. Null/[] = none sent yet.
  remindersSent  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startAt])
  @@index([leadId])
  @@index([status, startAt])
}

// ============================================
// BOOKING LINKS (leads self-book on the calendar)
// ============================================

model BookingLink {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  slug           String       @unique // public URL segment
  title          String
  description    String?
  durationMinutes Int         @default(30)
  bufferMinutes  Int          @default(0)
  timezone       String       @default("America/New_York") // tz the windows are defined in
  // Weekly availability windows: { "1": [["09:00","17:00"]], "2": [...] }
  // keyed by ISO weekday (1=Mon..7=Sun). Missing/empty = unavailable that day.
  availability   Json
  active         Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@index([organizationId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  MEETING_BOOKED
  MEETING_REMINDER
  HOT_REPLY
  LEAD_INTERESTED
  CALL_COMPLETED
  DIGEST
  SYSTEM
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // null = visible to the whole org; set = a specific user's notification.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String?
  leadId    String?  // deep-link target (not a FK — lead may be archived)
  read      Boolean  @default(false)
  emailedAt DateTime? // set once an alert email has been sent for this row

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, read])
}

// ============================================
// ENGINE CONSOLE (user <-> AI chat)
// ============================================

model EngineChat {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String       @default("New conversation")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages EngineChatMessage[]

  @@index([organizationId, updatedAt])
  @@index([userId])
}

model EngineChatMessage {
  id        String     @id @default(uuid())
  chatId    String
  chat      EngineChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String     // "user" | "assistant"
  content   String
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([chatId, createdAt])
}
